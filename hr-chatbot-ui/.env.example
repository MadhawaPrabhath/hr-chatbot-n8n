# Copy this file to .env.local and fill in the values.

# The Chat URL from your n8n "When chat message received" (Chat Trigger) node.
# Open the node -> turn on "Make Chat Publicly Available" -> Mode: "Embedded Chat"
# -> copy the Chat URL (it ends with /chat). Use the Production URL once the workflow is active.
N8N_CHAT_URL=http://localhost:5678/webhook/1c1dcb6d-f21d-4268-81b3-80bcc0eb5f4e/chat

# Optional: only if you set Authentication = "Basic Auth" on the Chat Trigger node.
N8N_CHAT_USER=
N8N_CHAT_PASSWORD=

# How long to wait for the agent before giving up (milliseconds).
N8N_TIMEOUT_MS=60000

# Set to "true" to try the UI without n8n running (returns fake answers).
MOCK_N8N=false
